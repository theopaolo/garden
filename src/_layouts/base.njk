<!DOCTYPE html>
<html class="view-transition" lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% set robotsContent = robots or (draft and "noindex, nofollow, noarchive") %}
    <meta name="description" content="Un jardin numérique cultivé par Théo.">
    {% if robotsContent %}
    <meta name="robots" content="{{ robotsContent }}">
    {% endif %}
    <meta name="theme-color" content="#5C4B75">
    <title>{{ title }}</title>
    <script>
        try {
            var theme = localStorage.getItem("theme");
            if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
        } catch (e) {}
    </script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
    <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="Jardin numérique">
</head>
<body>
    <svg class="fx-defs" aria-hidden="true" focusable="false" width="0" height="0">
        <defs>
            <filter id="card-grain" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
                <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="11" stitchTiles="stitch" result="noise" />
                <feColorMatrix in="noise" type="saturate" values="0" result="mono-noise" />
                <feComponentTransfer in="mono-noise" result="grain">
                    <feFuncA type="table" tableValues="0 0.055" />
                </feComponentTransfer>
                <feBlend in="SourceGraphic" in2="grain" mode="soft-light" />
            </filter>
        </defs>
    </svg>

    {{ content | safe }}

    <script type="module" src="/js/note-whimsy.js"></script>
    <script type="module" src="/js/transitions.js"></script>
    <script type="module" src="/js/theme-toggle.js"></script>
</body>
</html>
