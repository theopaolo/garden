---
layout: base.njk
---

<main class="container" id="top">
  <header class="note-header">
    <h1>{{ title }}</h1>
    <div class="note-meta">
      <time class="note-date">{{ date | formatDate }}</time>
      {% if tags %}
        <div class="note-tags">
          {% for tag in tags %}
            <a href="/tags/{{ tag | slugify }}/" class="tag">{{ tag }}</a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    {% if description %}
      <p class="note-chapo">{{ description }}</p>
    {% endif %}
  </header>

  <article class="note-content">
    {{ content | safe }}
  </article>

  <p class="back-to-top-wrap">
    <a href="#top" class="back-to-top">↑ retour en haut</a>
  </p>

  {% set otherNotes = collections.notes | reverse | excludeItemByUrl(page.url) | slice(0, 5) | rejectattr("data.layout", "equalto", "base.njk") %}

  {% if otherNotes.length %}
    <aside class="related-notes">
      <h2 class="notes-list-title">Autres graines</h2>
      <ul class="notes-list">
        {% for note in otherNotes %}
          <li>
            <a href="{{ note.url }}" class="note-item">
              <span class="note-title">{{ note.data.title or "Sans titre" }}</span>
              {% if note.data.tags %}
                {% for tag in note.data.tags %}
                  <span class="tag">{{ tag }}</span>
                {% endfor %}
              {% endif %}
              <span class="note-date">{{ note.date | formatDate }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </aside>
  {% endif %}

  <footer class="footer">
    <a href="/" class="back-link footer-button">← Retour</a>
    <a href="/feed.xml" class="footer-button rss-button" aria-label="Flux RSS">RSS</a>
  </footer>
</main>
