---
layout: base.njk
pagination:
    data: collections.tagList
    size: 1
    alias: tag
permalink: /tags/{{ tag | slug }}/
eleventyComputed:
    title: "{{ tag }}"
---

<main class="container">
  <header class="note-header">
    <h1>{{ tag }}</h1>
  </header>

  <ul class="notes-list">
    {% set taglist = collections[tag] %}
    {% for note in taglist | reverse %}
      <li>
        <a href="{{ note.url }}" class="note-item">
          <span class="note-title">{{ note.data.title or "Sans titre" }}</span>
          <span class="note-date">{{ note.date | formatDate }}</span>
        </a>
      </li>
    {% else %}
      <li><p>Aucune note avec ce tag.</p></li>
    {% endfor %}
  </ul>

  <footer class="footer">
    <a href="/" class="back-link footer-button">← Retour</a>
    <a href="/feed.xml" class="footer-button rss-button" aria-label="Flux RSS">RSS</a>
  </footer>
</main>
